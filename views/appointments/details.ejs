<% layout("layouts/boilerplate") %>

<h1>Book Appointment</h1>

<form action="/appointment" method="POST">

    <input
        type="hidden"
        name="appointmentDate"
        value="<%= appointmentDate %>"
    >

    <label>Name</label>
    <input type="text" name="patientName" required>

    <label>Mobile</label>
    <input type="text" name="mobile" required>

    <label>Age</label>
    <input type="number" name="age" required>

    <label>Gender</label>

    <select name="gender">

        <option>Male</option>
        <option>Female</option>
        <option>Other</option>

    </select>

    <label>Problem</label>

    <textarea
        name="problem"
        required
    ></textarea>

    <label>Select Slot</label>

    <select name="slot">

        <% let freeSlot = false; %>

        <% availableSlots.forEach(item=>{ %>

            <% if(item.available){ %>

                <% freeSlot = true; %>

                <option value="<%= item.slot %>">
                    <%= item.slot %>
                    (<%= 5-item.booked %> Left)
                </option>

            <% }else{ %>

                <option disabled>

                    <%= item.slot %>

                    (FULL)

                </option>

            <% } %>

        <% }) %>

    </select>

    <% if(freeSlot){ %>

        <button>
            Book Appointment
        </button>

    <% }else{ %>

        <h2 style="color:red">

            No Slots Available Today

        </h2>

    <% } %>

</form>