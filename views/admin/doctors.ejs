<% layout("layouts/boilerplate") %>

<h1>Doctors and Schedules</h1>

<form action="/admin/doctors" method="POST">
    <h2>Add Doctor</h2>
    <label for="doctor-name">Name</label>
    <input id="doctor-name" name="name" required>

    <label for="doctor-specialty">Specialty</label>
    <input id="doctor-specialty" name="specialty" required>

    <fieldset>
        <legend>Working days</legend>
        <% days.forEach((day, index) => { %>
            <label class="schedule-choice"><input type="checkbox" name="days[]" value="<%= index %>"> <span><%= day %></span></label>
        <% }) %>
    </fieldset>

    <fieldset>
        <legend>Available appointment times</legend>
        <% slots.forEach(slot => { %>
            <label class="schedule-choice"><input type="checkbox" name="slots[]" value="<%= slot %>"> <span><%= slot %></span></label>
        <% }) %>
    </fieldset>

    <button type="submit">Add Doctor</button>
</form>

<table>
    <thead><tr><th>Doctor</th><th>Specialty</th><th>Weekly schedule</th><th>Status</th><th>Action</th></tr></thead>
    <tbody>
        <% doctors.forEach(doctor => { %>
            <tr>
                <td><%= doctor.name %></td>
                <td><%= doctor.specialty %></td>
                <td><%= doctor.schedule.map(item => `${days[item.dayOfWeek]}: ${item.slots.join(", ")}`).join("; ") %></td>
                <td><%= doctor.active ? "Active" : "Inactive" %></td>
                <td>
                    <a href="/admin/doctors/<%= doctor._id %>/edit">Edit schedule</a>
                    <form action="/admin/doctors/<%= doctor._id %>/toggle" method="POST">
                        <button type="submit"><%= doctor.active ? "Deactivate" : "Activate" %></button>
                    </form>
                </td>
            </tr>
        <% }) %>
        <% if (!doctors.length) { %><tr><td colspan="5">No doctors have been added.</td></tr><% } %>
    </tbody>
</table>