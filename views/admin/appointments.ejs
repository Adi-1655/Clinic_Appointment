<% layout("layouts/boilerplate") %>

<section class="dashboard-page">
    <div class="page-heading-row">
        <div>
            <p class="dashboard-eyebrow">APPOINTMENTS CONTROL</p>
            <h1>All Appointments</h1>
        </div>
        <a class="button-link-secondary" href="/admin/dashboard">Back to Dashboard</a>
    </div>

    <div class="appointment-tabs" aria-label="Appointment status">
        <% ["Pending", "Completed", "Cancelled"].forEach(item => { %>
            <a href="/admin/appointments?status=<%= item %>" class="<%= status === item ? "active" : "" %>" <%= status === item ? 'aria-current="page"' : "" %>><%= item %></a>
        <% }) %>
    </div>

    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Time</th>
                <th>Patient Details</th>
                <th>Assigned Doctor</th>
                <th>Clinical Reason</th>
                <% if (status === "Pending") { %><th>Actions</th><% } %>
            </tr>
        </thead>
        <tbody>
            <% appointments.forEach(appointment => { %>
                <tr>
                    <td><%= appointment.appointmentDate %></td>
                    <td><strong><%= appointment.slot %></strong></td>
                    <td>
                        <strong><%= appointment.patientName %></strong>
                        <span class="muted-text" style="display: block; font-size: 13px;"><%= appointment.mobile %></span>
                    </td>
                    <td><%= appointment.doctor ? appointment.doctor.name : "Not assigned" %></td>
                    <td><%= appointment.problem %></td>
                    <% if (status === "Pending") { %>
                        <td class="appointment-actions">
                            <a class="button-link-secondary" style="padding: 6px 14px; font-size: 13px;" href="/admin/appointments/<%= appointment._id %>/reschedule">Reschedule</a>
                            <form action="/admin/appointments/<%= appointment._id %>/cancel" method="POST" style="display: inline-block; width: auto; margin: 0 0 0 6px; padding: 0; background: transparent; box-shadow: none; border: none;" onsubmit="return confirm('Are you sure you want to cancel this appointment?');">
                                <button type="submit" class="btn-delete-sm">Cancel</button>
                            </form>
                        </td>
                    <% } %>
                </tr>
            <% }) %>
            <% if (!appointments.length) { %>
                <tr><td colspan="<%= status === "Pending" ? 6 : 5 %>" class="empty-state">No <%= status.toLowerCase() %> appointments found.</td></tr>
            <% } %>
        </tbody>
    </table>
</section>