<% layout("layouts/boilerplate") %>

<h1>Appointments</h1>

<div class="appointment-tabs" aria-label="Appointment status">
    <% ["Pending", "Completed", "Cancelled"].forEach(item => { %>
        <a href="/admin/appointments?status=<%= item %>" class="<%= status === item ? "active" : "" %>" <%= status === item ? 'aria-current="page"' : "" %>><%= item %></a>
    <% }) %>
</div>

<h2><%= status %> Appointments</h2>

<table>
    <thead><tr><th>Date</th><th>Time</th><th>Patient</th><th>Doctor</th><th>Problem</th><% if (status === "Pending") { %><th>Actions</th><% } %></tr></thead>
    <tbody>
        <% appointments.forEach(appointment => { %>
            <tr>
                <td><%= appointment.appointmentDate %></td>
                <td><%= appointment.slot %></td>
                <td><%= appointment.patientName %><br><%= appointment.mobile %></td>
                <td><%= appointment.doctor ? appointment.doctor.name : "Not assigned" %></td>
                <td><%= appointment.problem %></td>
                <% if (status === "Pending") { %>
                    <td class="appointment-actions">
                        <a class="button-link" href="/admin/appointments/<%= appointment._id %>/reschedule">Reschedule</a>
                        <form action="/admin/appointments/<%= appointment._id %>/cancel" method="POST">
                            <button type="submit">Cancel</button>
                        </form>
                    </td>
                <% } %>
            </tr>
        <% }) %>
        <% if (!appointments.length) { %><tr><td colspan="<%= status === "Pending" ? 6 : 5 %>">No <%= status.toLowerCase() %> appointments found.</td></tr><% } %>
    </tbody>
</table>