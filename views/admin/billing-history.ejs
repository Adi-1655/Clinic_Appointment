<% layout("layouts/boilerplate") %>

<section class="today-appointments-page">
    <header class="page-heading-row">
        <div>
            <p class="dashboard-eyebrow">BILLING RECORDS</p>
            <h1>Billing History</h1>
            <p class="form-subtitle">Record of all generated invoices and one-time settlements</p>
        </div>
        <a class="button-link-secondary" href="/admin/billing">Back to Billing</a>
    </header>

    <div class="admin-card" style="margin-top: 20px;">
        <div class="section-heading">
            <h2>All Invoices</h2>
            <span style="font-size: 13.5px; color: var(--text-muted);"><%= invoices.length %> Total Records</span>
        </div>

        <table class="today-appointments-table">
            <thead>
                <tr>
                    <th>Bill Date</th>
                    <th>Patient</th>
                    <th>Visit Date</th>
                    <th>Total Amount</th>
                    <th>Method</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% invoices.forEach(invoice => { %>
                    <tr>
                        <td class="muted-text">
                            <%= invoice.createdAt ? new Date(invoice.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '-' %>
                        </td>
                        <td>
                            <strong style="color: var(--text-heading); display: block;"><%= invoice.appointment ? invoice.appointment.patientName : "Patient record unavailable" %></strong>
                            <% if (invoice.appointment && invoice.appointment.mobile) { %>
                                <span class="muted-text" style="font-size: 12.5px;"><%= invoice.appointment.mobile %></span>
                            <% } %>
                        </td>
                        <td><%= invoice.appointment ? invoice.appointment.appointmentDate : "-" %></td>
                        <td style="font-weight: 700; color: var(--brand-accent);">
                            ₹<%= invoice.totalAmount.toFixed(2) %>
                        </td>
                        <td>
                            <%= (invoice.payments && invoice.payments.length) ? invoice.payments[0].method : (invoice.paymentStatus === "Paid" ? "Direct" : "-") %>
                        </td>
                        <td>
                            <% if (invoice.paymentStatus === "Paid") { %>
                                <span class="appointment-status status-completed">Paid</span>
                            <% } else { %>
                                <span class="appointment-status">Unpaid</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (invoice.paymentStatus === "Paid") { %>
                                <span class="muted-text" style="font-size: 13px;">Settled</span>
                            <% } else { %>
                                <a class="btn-pill-primary" style="padding: 6px 14px; font-size: 12.5px;" href="/admin/billing/<%= invoice._id %>/payment">
                                    Collect Payment
                                </a>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
                <% if (!invoices.length) { %>
                    <tr>
                        <td colspan="7" class="empty-state" style="text-align: center; padding: 36px 20px;">
                            No billing records have been saved yet.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</section>