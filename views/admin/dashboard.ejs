<% layout("layouts/boilerplate") %>

<section class="dashboard-page">
	<header class="dashboard-intro">
		<p class="dashboard-eyebrow">Dashboard</p>
		<h1>Welcome to Hospital Management System</h1>
	</header>

	<section class="dashboard-metrics" aria-label="Hospital overview">
		<article class="dashboard-metric dashboard-metric-doctors">
			<span class="metric-icon" aria-hidden="true">&#129658;</span>
			<h2>Total Doctors</h2>
			<p><%= totalDoctors %></p>
		</article>
		<article class="dashboard-metric dashboard-metric-patients">
			<span class="metric-icon" aria-hidden="true">&#128101;</span>
			<h2>Total Patients</h2>
			<p><%= totalPatients %></p>
		</article>
		<a class="dashboard-metric dashboard-metric-appointments" href="/admin/todays-appointments">
			<span class="metric-icon" aria-hidden="true">&#128197;</span>
			<h2>Today's Appointments</h2>
			<p><%= totalToday %></p>
		</a>
	</section>

	<section class="specialization-section">
		<div class="section-heading">
			<h2>Doctor Specializations</h2>
			<span><%= specializations.length %> specialties</span>
		</div>

		<div class="specialization-list">
			<% specializations.forEach(item => { %>
				<div class="specialization-row">
					<span><%= item._id %></span>
					<strong><%= item.count %> <%= item.count === 1 ? "Doctor" : "Doctors" %></strong>
				</div>
			<% }) %>
			<% if (!specializations.length) { %>
				<p class="empty-state">No active doctor specializations have been added.</p>
			<% } %>
		</div>
	</section>
</section>