<% layout("layouts/boilerplate") %>

<section class="dashboard-page">
    <div class="page-heading-row">
        <div>
            <p class="dashboard-eyebrow">CLINICAL RECORDS</p>
            <h1>Consultations &amp; Prescriptions</h1>
        </div>
        <a class="button-link-secondary" href="/admin/dashboard">Back to Dashboard</a>
    </div>

    <table>
        <thead>
            <tr>
                <th>Date</th>
                <th>Patient</th>
                <th>Recommendation</th>
                <th>Prescription</th>
                <th>Prescription Document</th>
            </tr>
        </thead>
        <tbody>
            <% consultations.forEach(consultation => { %>
                <tr>
                    <td><%= consultation.appointment ? consultation.appointment.appointmentDate : consultation.createdAt.toLocaleDateString() %></td>
                    <td style="font-weight: 600;"><%= consultation.appointment ? consultation.appointment.patientName : "Appointment record unavailable" %></td>
                    <td><%= consultation.recommendation || "-" %></td>
                    <td><%= consultation.prescription || "-" %></td>
                    <td>
                        <% if (consultation.appointment && consultation.pdfPath) { %>
                            <a class="button-link-secondary" style="padding: 5px 14px; font-size: 13px;" href="/admin/consultation/pdf/<%= consultation.appointment._id %>">Download PDF</a>
                        <% } else { %>
                            <span class="muted-text">-</span>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
            <% if (!consultations.length) { %>
                <tr>
                    <td colspan="5" class="empty-state">No consultations have been recorded.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</section>