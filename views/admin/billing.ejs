<% layout("layouts/boilerplate") %>

<section class="today-appointments-page">
    <header class="page-heading-row">
        <div>
            <p class="dashboard-eyebrow">ADMINISTRATION</p>
            <h1>Billing</h1>
            <p class="today-date">Today's patients &middot; <%= todayDate %></p>
        </div>
        <a class="button-link-secondary" href="/admin/billing/history">Billing History</a>
    </header>

    <!-- Not Paid Patients Section: Only completed visits -->
    <section class="billing-patient-group admin-card" style="margin-top: 20px;">
        <div class="section-heading">
            <h2>Not Paid Patients</h2>
            <span style="font-size: 13.5px; color: var(--text-muted);">Completed visits awaiting payment</span>
        </div>

        <table class="today-appointments-table">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Patient</th>
                    <th>Mobile</th>
                    <th>Doctor</th>
                    <th>Reason</th>
                    <th>Visit Status</th>
                    <th>Payment</th>
                </tr>
            </thead>
            <tbody>
                <% notPaidAppointments.filter(a => a.status === "Completed").forEach(appointment => { %>
                    <% const invoice = invoiceByAppointment[String(appointment._id)]; %>
                    <tr>
                        <td style="font-weight: 600;"><%= appointment.slot %></td>
                        <td style="font-weight: 600; color: var(--text-heading);"><%= appointment.patientName %></td>
                        <td class="muted-text"><%= appointment.mobile %></td>
                        <td><%= appointment.doctor ? appointment.doctor.name : "Not assigned" %></td>
                        <td><%= appointment.problem %></td>
                        <td><span class="appointment-status status-completed"><%= appointment.status %></span></td>
                        <td>
                            <% if (invoice) { %>
                                <a class="btn-pill-primary" style="padding: 7px 16px; font-size: 13px;" href="/admin/billing/<%= invoice._id %>/payment">
                                    Collect Payment (₹<%= invoice.totalAmount.toFixed(2) %>)
                                </a>
                            <% } else { %>
                                <a class="btn-pill-primary" style="padding: 7px 16px; font-size: 13px;" href="/admin/billing/appointments/<%= appointment._id %>/invoice">
                                    Create Invoice
                                </a>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
                <% if (!notPaidAppointments.filter(a => a.status === "Completed").length) { %>
                    <tr>
                        <td colspan="7" class="empty-state" style="text-align: center; padding: 36px 20px;">
                            No completed visits with pending payment today.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </section>

    <!-- Paid Patients Section: One-time payment completed -->
    <section class="billing-patient-group admin-card" style="margin-top: 28px;">
        <div class="section-heading">
            <h2>Paid Patients</h2>
            <span style="font-size: 13.5px; color: var(--text-muted);"><%= paidAppointments.length %> Settled Today</span>
        </div>

        <table class="today-appointments-table">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Patient</th>
                    <th>Mobile</th>
                    <th>Doctor</th>
                    <th>Reason</th>
                    <th>Amount Paid</th>
                    <th>Method</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% paidAppointments.forEach(appointment => { %>
                    <% const invoice = invoiceByAppointment[String(appointment._id)]; %>
                    <tr>
                        <td style="font-weight: 600;"><%= appointment.slot %></td>
                        <td style="font-weight: 600; color: var(--text-heading);"><%= appointment.patientName %></td>
                        <td class="muted-text"><%= appointment.mobile %></td>
                        <td><%= appointment.doctor ? appointment.doctor.name : "Not assigned" %></td>
                        <td><%= appointment.problem %></td>
                        <td style="font-weight: 700; color: var(--brand-accent);">
                            ₹<%= invoice ? invoice.totalAmount.toFixed(2) : "0.00" %>
                        </td>
                        <td>
                            <%= (invoice && invoice.payments.length) ? invoice.payments[0].method : "Direct" %>
                        </td>
                        <td><span class="appointment-status status-completed">Paid</span></td>
                    </tr>
                <% }) %>
                <% if (!paidAppointments.length) { %>
                    <tr>
                        <td colspan="8" class="empty-state" style="text-align: center; padding: 36px 20px;">
                            No patients have completed payment today.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </section>
</section>