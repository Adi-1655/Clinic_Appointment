<% layout("layouts/boilerplate") %>

<section class="today-appointments-page">
    <header class="page-heading-row">
        <div>
            <p class="dashboard-eyebrow">Billing</p>
            <h1>Create Manual Invoice</h1>
        </div>
        <a class="button-link" href="/admin/billing">Back to Billing</a>
    </header>

    <section class="billing-record">
        <h2>Patient information</h2>
        <p><strong>Name:</strong> <%= appointment.patientName %></p>
        <p><strong>Mobile:</strong> <%= appointment.mobile %></p>
        <p><strong>Age:</strong> <%= appointment.age %></p>
        <p><strong>Gender:</strong> <%= appointment.gender %></p>
        <p><strong>Reason:</strong> <%= appointment.problem %></p>
        <p><strong>Doctor:</strong> <%= appointment.doctor ? `${appointment.doctor.name} (${appointment.doctor.specialty})` : "Not assigned" %></p>
        <p><strong>Appointment:</strong> <%= appointment.appointmentDate %> · <%= appointment.slot %></p>
    </section>

    <form action="/admin/billing/appointments/<%= appointment._id %>/invoice" method="POST">
        <h2>Invoice charges (INR)</h2>
        <label for="consultationFee">Consultation fee</label>
        <input id="consultationFee" type="number" name="consultationFee" min="0" step="0.01" value="0" required>

        <label for="medicineCharges">Medicine charges</label>
        <input id="medicineCharges" type="number" name="medicineCharges" min="0" step="0.01" value="0" required>

        <label for="otherCharges">Other charges</label>
        <input id="otherCharges" type="number" name="otherCharges" min="0" step="0.01" value="0" required>

        <h2>Initial payment (optional)</h2>
        <label for="paymentAmount">Amount received</label>
        <input id="paymentAmount" type="number" name="paymentAmount" min="0" step="0.01" value="0" required>

        <label for="paymentMethod">Payment method</label>
        <select id="paymentMethod" name="paymentMethod">
            <option value="">No payment received</option>
            <% ["Cash", "UPI", "Card", "Bank transfer"].forEach(method => { %>
                <option value="<%= method %>"><%= method %></option>
            <% }) %>
        </select>

        <button type="submit">Save Invoice</button>
    </form>
</section>